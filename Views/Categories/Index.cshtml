@model RaceDay.Web.Models.CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories";
}

<h2>Event Categories</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Add" method="post" class="row g-2 mb-4">
    <input type="hidden" name="eventId" value="@Model.EventId" />
    <div class="col-auto">
        <input name="newCategoryName" class="form-control" placeholder="e.g. Under 20, Senior, 10km" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add category</button>
    </div>
</form>

@if (!Model.Categories.Any())
{
    <p>This event has no categories yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Category</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td>@c.CategoryName</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Events" asp-action="Index" class="btn btn-secondary">Back to My Events</a>