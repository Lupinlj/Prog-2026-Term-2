@model RaceDay.Web.Models.ParticipantHomeViewModel
@{
    ViewData["Title"] = "Upcoming Events";
}

<h2 class="mb-4">Upcoming Events</h2>

<!-- The Filtering Form -->
<form asp-action="ParticipantHome" method="get" class="row g-3 mb-4 bg-light p-3 rounded shadow-sm">
    <div class="col-md-5">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by event name or location..." />
    </div>
    <div class="col-md-4">
        <select name="eventTypeFilter" class="form-select">
            <option value="">All Event Types</option>
            <option value="Run" selected="@(Model.EventTypeFilter == "Run")">Run</option>
            <option value="Walk" selected="@(Model.EventTypeFilter == "Walk")">Walk</option>
            <option value="Cycle" selected="@(Model.EventTypeFilter == "Cycle")">Cycle</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Filter Events</button>
    </div>
</form>

<!-- The Events Display -->
@if (!Model.Events.Any())
{
    <div class="alert alert-info">No upcoming events found matching your criteria.</div>
}
else
{
    <div class="row">
        @foreach (var e in Model.Events)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title text-primary fw-bold">@e.EventName</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@e.EventDate.ToString("dd MMM yyyy")</h6>
                        <p class="card-text mt-3">
                            <strong>Location:</strong> @e.EventLocation <br />
                            <strong>Type:</strong> @e.EventType <br />
                            <strong>Distance:</strong> @e.Distance km
                        </p>
                        <!-- This button will link to the Details page we build next -->
                        <a href="#" class="btn btn-outline-primary w-100 mt-2">View Details & Enrol</a>
                    </div>
                </div>
            </div>
        }
    </div>
}