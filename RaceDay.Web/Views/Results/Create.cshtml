@model RaceDay.Web.Models.ResultFormViewModel
@{
    ViewData["Title"] = "Enter Result";
}

<h2>Enter Result</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Hidden field to pass the EnrolmentId back to the controller -->
    <input type="hidden" asp-for="EnrolmentId" />

    <div class="mb-3">
        <label asp-for="FinishTime" class="form-label">Finish Time</label>
        <!-- The type="time" gives the user a nice time picker -->
        <input asp-for="FinishTime" type="time" step="1" class="form-control" />
        <span asp-validation-for="FinishTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Position" class="form-label">Finishing Position</label>
        <input asp-for="Position" class="form-control" placeholder="e.g. 47" />
        <span asp-validation-for="Position" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Result</button>
    <!-- Redirect back to the Organiser Enrolments page -->
    <a asp-controller="Enrolments" asp-action="OrganiserIndex" asp-route-eventId="@ViewBag.EventId" class="btn btn-secondary">Cancel</a>
</form>